# ─────────────────────────────────────────────────────────────
# Choix du backend : "mock" (par défaut, aucune clé requise) ou "firebase"
# ─────────────────────────────────────────────────────────────
VITE_BACKEND=mock

# ─────────────────────────────────────────────────────────────
# Firebase (requis uniquement si VITE_BACKEND=firebase)
# Console Firebase → Paramètres du projet → Vos applications (Web)
# Choisir une région UE (eur3 / europe-west) pour le RGPD.
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# Google Maps Platform (optionnel — pour la vue carte réelle)
# ─────────────────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=
