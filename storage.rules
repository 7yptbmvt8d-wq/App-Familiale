rules_version = '2';

// Règles Storage — App familiale privée.
// Prototype : tout membre authentifié accède aux médias de sa famille.
// Production : restreindre par appartenance via custom claims ou Cloud Function.
service firebase.storage {
  match /b/{bucket}/o {
    match /families/{fid}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
