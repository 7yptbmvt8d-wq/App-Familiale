rules_version = '2';

// Règles de sécurité Firestore — App familiale privée.
// Principes : accès sur invitation, isolation par famille, partage de
// localisation OBLIGATOIRE et non désactivable pour les mineurs.
service cloud.firestore {
  match /databases/{database}/documents {

    // Index uid → famille/membre. Lisible/écrivable par son propriétaire.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    function myFamily() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId;
    }
    function isMember(fid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myFamily() == fid;
    }
    function isAdmin(fid) {
      return isMember(fid)
        && get(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Codes d'invitation (id = code). Un utilisateur authentifié peut LIRE un
    // code précis (redeem) ; lister/créer/supprimer est réservé à l'admin de la
    // famille concernée.
    match /inviteCodes/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && isAdmin(resource.data.familyId);
      allow create: if request.auth != null && isAdmin(request.resource.data.familyId);
      allow delete: if request.auth != null && isAdmin(resource.data.familyId);
      // Acceptation : un nouvel arrivant authentifié passe le code à "accepted".
      allow update: if request.auth != null;
    }

    match /families/{fid} {
      allow read: if isMember(fid);
      // Création d'une nouvelle famille : l'auteur (déjà rattaché via users/{uid}) la crée.
      allow create: if request.auth != null && isMember(fid);
      allow write: if isAdmin(fid);

      match /members/{memberId} {
        allow read: if isMember(fid);

        // Création de sa propre fiche (après création de users/{uid}).
        allow create: if isMember(fid) && request.auth.uid == memberId;

        // Mise à jour de soi-même ; un mineur ne peut JAMAIS désactiver le partage.
        allow update: if isMember(fid)
          && request.auth.uid == memberId
          && !(resource.data.role == 'minor' && request.resource.data.sharing != 'auto');

        // L'admin gère (rôles, blocage, suppression).
        allow write: if isAdmin(fid);
      }

      match /locations/{memberId} {
        allow read: if isMember(fid);
        // Chacun n'écrit que sa propre position.
        allow write: if isMember(fid) && request.auth.uid == memberId;
      }

      match /posts/{postId} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && request.resource.data.authorId == request.auth.uid;
        allow update: if isMember(fid);
        allow delete: if isAdmin(fid) || resource.data.authorId == request.auth.uid;
      }
    }
  }
}
