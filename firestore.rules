rules_version = '2';

// Règles de sécurité Firestore — App familiale privée.
// Principes : accès sur invitation uniquement, isolation par famille,
// partage de localisation OBLIGATOIRE et non désactivable pour les mineurs.
service cloud.firestore {
  match /databases/{database}/documents {

    // Index uid → famille/membre. Lisible/écrivable par son propriétaire.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    function myFamily() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId;
    }
    function isMember(fid) {
      return request.auth != null && myFamily() == fid;
    }
    function myRole(fid) {
      return get(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid)).data.role;
    }
    function isAdmin(fid) {
      return isMember(fid) && myRole(fid) == 'admin';
    }

    match /families/{fid} {
      // Tout membre de la famille peut lire la fiche famille ; admin seul écrit.
      allow read: if isMember(fid);
      allow write: if isAdmin(fid);

      match /members/{memberId} {
        allow read: if isMember(fid);

        // Mise à jour de soi-même, mais un mineur ne peut JAMAIS désactiver le partage.
        allow update: if isMember(fid)
          && request.auth.uid == memberId
          && !(resource.data.role == 'minor' && request.resource.data.sharing != 'auto');

        // Création de sa propre fiche à l'acceptation d'une invitation.
        allow create: if isMember(fid) && request.auth.uid == memberId;

        // L'admin gère (rôles, blocage, suppression).
        allow write: if isAdmin(fid);
      }

      match /locations/{memberId} {
        allow read: if isMember(fid);
        // Chacun n'écrit que sa propre position.
        allow write: if isMember(fid) && request.auth.uid == memberId;
      }

      match /posts/{postId} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && request.resource.data.authorId == request.auth.uid;
        // Favoris / commentaires ouverts aux membres ; suppression réservée à l'auteur ou l'admin.
        allow update: if isMember(fid);
        allow delete: if isAdmin(fid) || resource.data.authorId == request.auth.uid;
      }

      match /invitations/{inviteId} {
        // Lecture par les membres (admin UI) ; création/révocation par l'admin.
        allow read: if isMember(fid);
        allow create, delete: if isAdmin(fid);
        // L'acceptation (passage à "accepted") est permise au nouvel arrivant authentifié.
        allow update: if request.auth != null;
      }
    }
  }
}
